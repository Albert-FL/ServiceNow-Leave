        <name>TimeSelect</name>
        <order/>
        <script><![CDATA[function onLoad() {
    // 替换成你的字段名
    makeTimeStep30('leave_time_start');
    makeTimeStep30('leave_time_end');
}

function makeTimeStep30(fieldName) {
    var el = g_form.getControl(fieldName);
    if (!el) return;

    // 捕获时间框上下箭头点击
    el.addEventListener('click', function(e) {
        setTimeout(function() {
            var val = g_form.getValue(fieldName);
            if (!val) return;

            var parts = val.split(':');
            var h = parseInt(parts[0], 10);
            var m = parseInt(parts[1], 10);

            // 强制变成 30 分钟倍数
            if (m < 30) m = 0;
            else m = 30;

            // 组装新时间
            var newTime = 
                String(h).padStart(2, '0') + 
                ':' + 
                String(m).padStart(2, '0') + 
                ':00';

            g_form.setValue(fieldName, newTime);
        }, 10);
    });
}]]></script>

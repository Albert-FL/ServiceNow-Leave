        <script><![CDATA[(function() {
    // 1. 获取当前请假单的唯一标识（用于销假表单关联）
    var leaveSysId = current.getUniqueValue();  // 原请假单sys_id
	var cancelTable = 'x_1973840_leave_leave_cancel';
	var grCancel = new GlideRecord(cancelTable);
	grCancel.addQuery('leave_num', leaveSysId);
	grCancel.query();

	if (grCancel.next()) {
        // 已存在销假记录 → 直接打开该记录
        action.setRedirectURL(grCancel);
    }else{
        // 不存在 → 新建销假记录，并自动关联当前请假单
        var newCancel = new GlideRecord(cancelTable);
        newCancel.initialize();
        // 赋值关联字段（Reference类型，直接赋值current）
        newCancel.leave_num = leaveSysId;
		newCancel.leave_start_time = current.leave_start_period.toString();
		newCancel.leave_end_time = current.leave_end_period.toString();
        newCancel.insert();
        // 打开新建的销假记录
        action.setRedirectURL(newCancel);
	}
})();]]></script>

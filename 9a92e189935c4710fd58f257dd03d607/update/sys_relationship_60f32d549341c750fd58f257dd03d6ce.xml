        <query_from/>
        <query_with><![CDATA[(function refineQuery(current, parent) {
	// current = 当前查询的表：销假表 LEAVE CANCEL
	// parent = 打开的主表：Employee Year Leave 年假表

	// 筛选条件：销假表的 employee 字段 等于 年假表的 Opened_by 字段
	current.addQuery('employee',parent.Opened_by);
	
	// 获取年假表中的年度，并转换为字符串类型
	var year = parent.year.toString(); 
	// 筛选条件：销假表的开始日期 cancel_start_date 以当前年度开头（同一年）
    current.addQuery('cancel_start_date', 'STARTSWITH', year);
	// 筛选条件：已审批通过的销假数据
	current.addQuery('approval', 'Approved');

})(current, parent);]]></query_with>

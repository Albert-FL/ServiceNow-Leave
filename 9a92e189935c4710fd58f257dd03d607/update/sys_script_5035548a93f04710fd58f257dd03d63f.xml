        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	// Add your code here
	// 英文状态 → 中文映射（和客户端保持一致）
    var statusMap = {
		'not requested': '待申请',
        'requested': '审批中',
        'Approved': '已通过',
        'Rejected': '已拒绝'
    };

    // 获取当前审批状态
    var enStatus = current.approval;
    // 赋值中文到显示字段
    if (statusMap[enStatus]) {
        current.approval_visable = statusMap[enStatus];
    } else {
        // 未知状态默认值
        current.approval_visable = "状态异常";
    }
})(current, previous);]]></script>

        <script><![CDATA[
    var leaveRecord = new GlideRecord('x_1973840_leave_request');
    if (leaveRecord.get(current.original_leave_request)) {
      var totalCancelledHours = parseFloat(leaveRecord.cancelled_hours || 0) + parseFloat(current.cancel_hours);
      
      if (totalCancelledHours > parseFloat(leaveRecord.leave_hours)) {
        gs.addErrorMessage('销假小时数不能超过请假小时数。请假总时数: ' + leaveRecord.leave_hours + '小时，已销假: ' + (leaveRecord.cancelled_hours || 0) + '小时，本次销假: ' + current.cancel_hours + '小时');
        current.setAbortAction(true);
        return false;
      }
    }
    return true;
  ]]></script>
